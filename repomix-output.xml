<file path="src/css/styles.css">
/* ==========================================================================
   LÁCTEOS BONANZA S.A. - HOJA DE ESTILOS UNIFICADA
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap');

/* Variables Oficiales de Marca */
:root {
    --amarillo-bonanza: #FFB300;   /* Primario: Navbars, encabezados */
    --verde-frescura: #00A896;     /* Secundario: Títulos, precios */
    --naranja-vibrante: #E65100;   /* Acento: Botones principales */
    --blanco-neutro: #FFFFFF;      /* Tarjetas y contenedores */
    --gris-oscuro: #212529;         /* Textos y Footer */
    --fondo-pagina: #FDFBF7;       /* Fondo crema lácteo */
}

/* Reset y Layout para Sticky Footer */
html, body {
    height: 100%;
    margin: 0;
    background-color: var(--fondo-pagina);
    color: var(--gris-oscuro);
    font-family: 'Nunito', sans-serif;
}

#app {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

main {
    flex: 1 0 auto;
}

footer {
    margin-top: auto !important;
    background-color: var(--gris-oscuro) !important;
    color: var(--blanco-neutro);
}

/* Tipografías de Títulos */
h1, h2, h3, h4, h5, h6, 
.navbar-brand, 
.card-title {
    font-family: 'Fredoka', cursive, sans-serif;
}

/* Componentes Sobrescritos */
.navbar {
    background-color: var(--amarillo-bonanza) !important;
}

.navbar-brand, .nav-link {
    color: var(--gris-oscuro) !important;
}

.text-success {
    color: var(--verde-frescura) !important;
}

.btn-success {
    background-color: var(--naranja-vibrante) !important;
    border-color: var(--naranja-vibrante) !important;
    font-family: 'Fredoka', sans-serif;
}

.btn-success:hover {
    background-color: #BF360C !important;
    border-color: #BF360C !important;
}

.btn-outline-success {
    color: var(--verde-frescura) !important;
    border-color: var(--verde-frescura) !important;
}

.btn-outline-success:hover, 
.btn-outline-success.active {
    background-color: var(--verde-frescura) !important;
    color: var(--blanco-neutro) !important;
}

.card {
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease;
}

.card:hover {
    transform: translateY(-3px);
}
</file>

<file path="src/js/auth/login.js">
import { signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { auth } from "../firebase/config.js";

const form = document.getElementById("login-form");
const msg = document.getElementById("mensaje");
const emailInput = document.getElementById("email");
const passwordInput = document.getElementById("password");

function mensajeErrorLogin(error) {
  const mensajes = {
    "auth/invalid-email": "El correo electrónico no tiene un formato válido.",
    "auth/user-not-found": "No existe una cuenta con ese correo.",
    "auth/wrong-password": "La contraseña es incorrecta.",
    "auth/invalid-credential": "El correo o la contraseña son incorrectos.",
    "auth/user-disabled": "Esta cuenta está deshabilitada.",
    "auth/too-many-requests": "Hubo demasiados intentos. Inténtalo más tarde.",
    "auth/network-request-failed": "No se pudo conectar. Comprueba tu conexión."
  };

  return mensajes[error.code] || error.message || "No se pudo iniciar sesión.";
}

form.addEventListener("submit", async (e) => {
  e.preventDefault();
  try {
    await signInWithEmailAndPassword(auth, emailInput.value.trim(), passwordInput.value);
    msg.innerHTML = '<div class="alert alert-success">Inicio de sesión correcto.</div>';
    setTimeout(() => location.href = "../../index.html", 700);
  } catch (err) {
    console.error(err);
    msg.replaceChildren();
    const alert = document.createElement("div");
    alert.className = "alert alert-danger";
    alert.textContent = mensajeErrorLogin(err);
    msg.append(alert);
  }
});
</file>

