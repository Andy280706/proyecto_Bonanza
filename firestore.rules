rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    match /usuarios/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.rol == "cliente";
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.rol == resource.data.rol;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /productos/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pedidos/{orderId} {
      allow create: if request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.productos is list
        && request.resource.data.productos.size() > 0
        && (isAdmin()
          || (signedIn() && request.resource.data.usuarioId == request.auth.uid));
      allow read: if isAdmin()
        || (signedIn() && resource.data.usuarioId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /categorias/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contactos/{contactId} {
      allow create: if request.resource.data.keys().hasAll(["nombre", "correo", "mensaje"])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 1000
        && request.resource.data.correo is string
        && request.resource.data.correo.size() > 0
        && request.resource.data.correo.size() <= 1000
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() > 0
        && request.resource.data.mensaje.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }
  }
}
